{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nbmecalc-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "mcp.nbmecalc.com", "zone_name": "nbmecalc.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NBMECALC_MCP", "class_name": "NBMEcalcMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NBMEcalcMCP"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
